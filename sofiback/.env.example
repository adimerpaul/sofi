APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sofiback
DB_USERNAME=root
DB_PASSWORD=

DB_HOST2=127.0.0.1
DB_PORT2=3306
DB_DATABASE2=aron-9
DB_USERNAME2=root
DB_PASSWORD2=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SIAT / Impuestos Nacionales (ver config/siat.php)
# Piloto: SIAT_URL_CONSULTA=https://pilotosiat.impuestos.gob.bo/consulta/QR
#         SIAT_URL_SERVICIOS=https://pilotosiatservicios.impuestos.gob.bo/v2/
SIAT_NIT=3779602010

# Semilla del modulo de Impuestos: solo se usa cuando corre la migracion que
# crea siat_configuraciones. Despues todo se edita desde la pantalla
# /impuestos y estas variables ya no tienen efecto.
SIAT_RAZON_SOCIAL="ALMACEN SOFIA"
SIAT_MODALIDAD=2
SIAT_CODIGO_SISTEMA=
SIAT_CODIGO_SUCURSAL=0
SIAT_CODIGO_PUNTO_VENTA=0
# Token delegado (JWT). Es un secreto: nunca subirlo al repo.
SIAT_TOKEN=
URL_SIAT=https://siatrest.impuestos.gob.bo/v2/
URL_SIAT2=https://siat.impuestos.gob.bo/
